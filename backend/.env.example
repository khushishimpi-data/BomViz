# Copy to backend/.env. Values below match docker-compose.yml service names.
# local | test | production
APP_ENV=local
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=json
API_V1_PREFIX=/api/v1
# comma-separated; empty disables CORS
CORS_ORIGINS=http://localhost:5173

# Must match POSTGRES_* in the root .env
DATABASE_URL=postgresql+asyncpg://bomviz:change-me-local-only@postgres:5432/bomviz
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# REQUIRED in production (>= 32 random chars): python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# must be true in production
REFRESH_COOKIE_SECURE=false

# S3_ENDPOINT_URL: how the backend reaches storage. S3_PUBLIC_ENDPOINT_URL: host used in
# signed URLs handed to browsers. Leave both empty for AWS S3. Credentials must match the
# MINIO_ROOT_* values in the root .env.
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=bomviz-minio
S3_SECRET_ACCESS_KEY=change-me-local-only
S3_BUCKET=bomviz
S3_REGION=us-east-1
SIGNED_URL_TTL_SECONDS=300

READINESS_TIMEOUT_SECONDS=2
