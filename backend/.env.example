# Copy to backend/.env. Values below match docker-compose.yml service names.
# local | test | production
APP_ENV=local
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=json
API_V1_PREFIX=/api/v1
# comma-separated; empty disables CORS
CORS_ORIGINS=http://localhost:5173

# Must match POSTGRES_* in the root .env
DATABASE_URL=postgresql+asyncpg://bomviz:change-me-local-only@postgres:5432/bomviz
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# REQUIRED in production (>= 32 random chars): python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
# "iss" claim set on and required of every access token
JWT_ISSUER=bomviz
# "aud" claim set on and required of every access token
JWT_AUDIENCE=bomviz-api
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# name of the HttpOnly refresh-token cookie
REFRESH_COOKIE_NAME=bomviz_refresh
# cookie is only sent to the auth routes
REFRESH_COOKIE_PATH=/api/v1/auth
# must be true in production
REFRESH_COOKIE_SECURE=false

# failed sign-ins per (email, IP) allowed before progressive delays start
LOGIN_FREE_ATTEMPTS=4
# first delay after the free attempts; doubles on each further failure
LOGIN_BASE_DELAY_SECONDS=30
# upper bound for a single sign-in delay
LOGIN_MAX_DELAY_SECONDS=900
# failure count resets when the last failure is older than this
LOGIN_THROTTLE_RESET_HOURS=24
# Redis rate limits on register/login/refresh; keep true outside tests
RATE_LIMIT_ENABLED=true
# Comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-For is believed. Empty trusts
# nobody (client IP = direct peer). docker-compose.yml sets it to the frontend (Vite proxy)
# container's fixed address; set it to your load balancer's address(es) in production.
TRUSTED_PROXY_IPS=

# S3_ENDPOINT_URL: how the backend reaches storage. S3_PUBLIC_ENDPOINT_URL: host used in
# signed URLs handed to browsers. Leave both empty for AWS S3. Credentials must match the
# MINIO_ROOT_* values in the root .env.
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=bomviz-minio
S3_SECRET_ACCESS_KEY=change-me-local-only
S3_BUCKET=bomviz
S3_REGION=us-east-1
SIGNED_URL_TTL_SECONDS=300

# largest accepted BOM file in bytes (20 MB); bigger uploads get 413 FILE_TOO_LARGE
MAX_UPLOAD_BYTES=20971520
# data rows allowed after the header row; more fails parsing with PARSE_TOO_MANY_ROWS
PARSE_MAX_ROWS=50000
# columns allowed per sheet; more fails parsing with PARSE_TOO_MANY_COLUMNS
PARSE_MAX_COLUMNS=200
# characters allowed in one cell (the Excel cell limit); longer fails with PARSE_CELL_TOO_LONG
PARSE_MAX_CELL_CHARS=32767
# data rows kept in the stored preview snapshot
PARSE_SAMPLE_ROWS=100
# zip-bomb guard: max total uncompressed size of an .xlsx archive in bytes (200 MB)
PARSE_MAX_UNCOMPRESSED_BYTES=209715200
# a queued/running job older than this no longer blocks a new parse request
JOB_STALE_AFTER_MINUTES=15
# a parse run longer than this fails with PARSE_FILE_TOO_COMPLEX; must be < JOB_STALE_AFTER_MINUTES*60
PARSE_SOFT_TIME_LIMIT_SECONDS=600
# the worker process running a parse is killed after this; must be > the soft limit
PARSE_HARD_TIME_LIMIT_SECONDS=660

READINESS_TIMEOUT_SECONDS=2
