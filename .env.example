# Read by docker compose for the infrastructure containers. Copy to .env.
# POSTGRES_* must match DATABASE_URL in backend/.env; MINIO_ROOT_* must match S3_* there.
POSTGRES_DB=bomviz
POSTGRES_USER=bomviz
POSTGRES_PASSWORD=change-me-local-only
MINIO_ROOT_USER=bomviz-minio
MINIO_ROOT_PASSWORD=change-me-local-only
S3_BUCKET=bomviz

# Host ports. Change any that clash with services already running on your machine.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
